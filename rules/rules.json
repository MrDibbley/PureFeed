{
  "schemaVersion": 1,
  "updated": "2026-10-20.4",
  "notes": "Detection data for assets/filter.js. See docs/selectors.md for how each signal was found. All strings are matched case-insensitively after icon glyphs are stripped. Bump \"updated\" on every change (e.g. 2026-10-17.2): the app ignores downloaded files older than its built-in copy.",

  "units": {
    "selector": "[data-tracking-duration-id]",
    "parentSelector": "[data-type=\"vscroller\"]"
  },

  "text": {
    "selector": "[data-mcomponent$=\"TextArea\"]",
    "headerTextLimit": 5,
    "strip": "[\\uE000-\\uF8FF\\u200E\\u200F]|[\\u{F0000}-\\u{FFFFD}]"
  },

  "rules": {
    "sponsored": {
      "label": "Sponsored",
      "color": "#E53935",
      "match": {
        "headerText": ["Ad", "Sponsored"],
        "headerPattern": "^paid for by "
      }
    },
    "suggested": {
      "label": "Suggested",
      "color": "#FB8C00",
      "match": { "headerText": ["Follow", "Suggested for you"] }
    },
    "groups": {
      "label": "Group suggestion",
      "color": "#8E24AA",
      "match": { "headerText": ["Join", "Suggested groups", "Groups you might like"] }
    },
    "reels": {
      "label": "Reels",
      "color": "#1E88E5",
      "match": { "headerText": ["Reels", "Reels and short videos"] }
    },
    "pymk": {
      "label": "People you may know",
      "color": "#00897B",
      "match": { "headerText": ["People you may know"] }
    },
    "memories": {
      "label": "Memories",
      "color": "#6D4C41",
      "unverified": true,
      "match": {
        "headerText": ["Memories", "On this day", "Your memories"],
        "headerPattern": "^\\d+ years? ago$"
      }
    },
    "stories": {
      "label": "Stories",
      "color": "#C2185B",
      "kind": "section",
      "match": { "anyText": ["Create story"] }
    },
    "appPrompts": {
      "label": "App prompt",
      "color": "#757575",
      "kind": "fixed",
      "match": { "anyText": ["Open app", "Get app", "Get Facebook for Android", "Use the app"] },
      "maxAncestorDepth": 10
    }
  },

  "feeds": {
    "notes": "Feeds = Facebook's chronological feed. It has no URL; it is opened from the menu.",
    "menuButtonSelector": "[aria-label=\"Facebook menu\"]",
    "menuItemText": ["Feeds"],
    "titleSelector": "[data-testid=\"nav_bar_component\"]",
    "titleText": ["Feeds"],
    "filterChips": {
      "all": "All",
      "favourites": "Favourites",
      "friends": "Friends",
      "groups": "Groups",
      "pages": "Pages"
    },
    "timeoutMs": 10000,
    "switchTimeoutMs": 6000
  },

  "video": {
    "notes": "With autoplay blocked, a paused feed video's poster is set to the thumbnail <img> inside this container.",
    "containerSelector": "[data-mcomponent=\"MVideo\"]"
  },

  "photoSave": {
    "notes": "The Save item in a photo's menu. Tapping it shows \"Saving photo…\" at once; repeat taps are ignored until the file arrives.",
    "buttonSelector": "[aria-label=\"Save\"]",
    "pathPattern": "^/photo",
    "timeoutMs": 30000
  },

  "cssFixes": [
    {
      "why": "Photo viewer: a server-rendered photo (ServerImageArea) sometimes isn't swapped for the script version, and its image keeps top:248px; height:648px, so it lands below the screen (black or only the top showing). top:0 alone wasn't enough: an absolute 100% height resolved to 648px, so the image is taken out of absolute positioning to fill its own 288px box.",
      "css": "[data-mcomponent=\"ServerImageArea\"] > img { position: static !important; top: auto !important; width: 100% !important; height: 100% !important; }"
    }
  ],

  "nav": {
    "notes": "PureFeed's own navigation. Home-screen tabs are role=tab with labels like 'messages, 3 new, 3 of 6'.",
    "tabSelector": "[role=\"tab\"][aria-label]",
    "tabPattern": "^([a-z ]+?)(?:, (\\d+) new)?, \\d+ of \\d+$",
    "tabNames": { "feed": "feed", "friends": "friends", "messages": "messages", "notifications": "notifications" },
    "homeChrome": ["[aria-label=\"Facebook logo\"]", "[role=\"tablist\"]"],
    "searchSelector": "[aria-label=\"Search Facebook\"]",
    "paths": { "feed": "/", "friends": "/friends/", "messages": "/messages/", "notifications": "/notifications/", "menu": "/bookmarks/", "search": "/search/" }
  },

  "userRules": {
    "keywords": { "label": "Keyword", "color": "#43A047" },
    "muted": { "label": "Muted", "color": "#F4511E", "headerTextsToCheck": 2 }
  }
}
